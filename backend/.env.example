# CampusCrew 后端环境变量示例
# 复制为 .env 后按实际环境修改

APP_NAME=CampusCrew
DEBUG=true

# MySQL 连接串（charset=utf8mb4 必须保留）
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/campus_crew?charset=utf8mb4

# JWT 密钥（生产环境务必替换为足够长的随机串）
JWT_SECRET_KEY=please-change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# 校园邮箱域名白名单（逗号分隔，全部转小写后比较）
ALLOWED_EMAIL_DOMAINS=@stu.example.edu

# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173
