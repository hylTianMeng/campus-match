# ============ CampusCrew 后端环境变量模板 ============
# 用法：复制为 .env 后填写。应用启动时通过 python-dotenv 自动加载。
# .env 已被 .gitignore 排除，不会提交到 git，可安全存放密钥。

# 数据库文件路径（SQLite）
DATABASE_PATH=./data/campuscrew.sqlite3

# Cookie 安全（生产 HTTPS 部署时设为 1）
COOKIE_SECURE=0

# 允许跨域写入的来源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# 种子开发账号密码（仅本地开发用，生产勿用）
SEED_PASSWORD=CampusCrew-Dev-2026

# 校园邮箱域名白名单（逗号分隔，全部转小写后比较）
ALLOWED_EMAIL_DOMAINS=mails.tsinghua.edu.cn,tsinghua.edu.cn

# ============ 邮件发送（SMTP）============
# SMTP_ENABLED=0（默认）：开发态直通，验证码打印到后端日志并返回 dev_code
# SMTP_ENABLED=1：走真实 SMTP 发送邮件（不返回 dev_code）
SMTP_ENABLED=0
# SMTP 服务器地址（如 QQ 邮箱：smtp.qq.com；163：smtp.163.com；学校邮箱见学校文档）
SMTP_HOST=
# SMTP 端口（587=STARTTLS，465=SSL）
SMTP_PORT=587
# SMTP 登录账号（通常就是发件邮箱地址）
SMTP_USER=
# SMTP 授权码 / 密码（QQ、163 需用「授权码」而非登录密码）
SMTP_PASSWORD=
# 发件人地址（可选，默认取 SMTP_USER）
MAIL_FROM=

# 种子管理员邮箱（seed 时幂等提权为管理员）
ADMIN_EMAIL=lin@example.test
